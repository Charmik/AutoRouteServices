# hz3 user unit (installed by AutoRouteServices/install_hz3_worker.sh): every minute, catches a missed hook, a stale flag or a worker
# (re)started during a CI job.
[Unit]
Description=Freeze/thaw the hz3 worker to match CI, every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
